generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  password        String
  name            String
  role            Role       @default(USER)
  phone           String?
  avatar          String?
  birthDate       String?
  gender          String?
  rewardPoints    Int        @default(0)
  membershipLevel String     @default("STAR") // STAR, GSTAR, XSTAR
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  bookings        Booking[]
  reviews         Review[]
  seatHolds       SeatHold[]
  blogs           Blog[]
}

enum Role {
  USER
  ADMIN
  STAFF
  ACCOUNTANT
}

model Movie {
  id          String       @id @default(uuid())
  title       String
  description String
  genre       String
  duration    Int // in minutes
  trailerUrl  String?
  posterUrl   String?
  status      String // e.g. NOW_SHOWING, COMING_SOON
  releaseDate String?
  ageRating   String?
  rating      Float?
  votes       Int?
  country     String?
  producer    String?
  director    String?
  actors      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  showtimes   Showtime[]
  reviews     Review[]
  movieGenres MovieGenre[]
  movieActors MovieActor[]
  blogs       Blog[]
}

model Cinema {
  id            String         @id @default(uuid())
  name          String
  location      String
  address       String?
  city          String         @default("TP.HCM")
  phone         String?
  mapUrl        String?
  directionsUrl String?
  amenities     String[]       @default([])
  rooms         Room[]
  groupBookings GroupBooking[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Room {
  id        String     @id @default(uuid())
  name      String
  cinemaId  String
  cinema    Cinema     @relation(fields: [cinemaId], references: [id])
  seats     Seat[]
  showtimes Showtime[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([cinemaId])
}

model Seat {
  id        String     @id @default(uuid())
  name      String // e.g. A1, B2
  type      SeatType   @default(STANDARD)
  roomId    String
  room      Room       @relation(fields: [roomId], references: [id])
  bookings  Ticket[]
  seatHolds SeatHold[]

  @@index([roomId])
}

enum SeatType {
  STANDARD
  VIP
  SWEETBOX
}

model Showtime {
  id        String     @id @default(uuid())
  movieId   String
  movie     Movie      @relation(fields: [movieId], references: [id])
  roomId    String
  room      Room       @relation(fields: [roomId], references: [id])
  format    String     @default("2D") // 2D, 3D, IMAX
  language  String     @default("SUB") // SUB, DUB
  startTime DateTime
  endTime   DateTime
  tickets   Ticket[]
  seatHolds SeatHold[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([movieId, startTime])
  @@index([roomId, startTime])
  @@index([startTime])
  @@index([format])
}

model Booking {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  status         String // PENDING, COMPLETED, CANCELLED
  paymentMethod  String? // VNPAY, MOMO, CASH
  paymentStatus  String        @default("UNPAID") // UNPAID, PAID, FAILED
  voucherCode    String?
  voucherId      String?
  voucher        Voucher?      @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  discountAmount Float         @default(0)
  ticketCode     String?       @unique
  qrCodeUrl      String?
  total          Float
  tickets        Ticket[]
  foodItems      BookingFood[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([voucherId])
  @@index([status])
  @@index([createdAt])
}

model Ticket {
  id            String       @id @default(uuid())
  bookingId     String
  booking       Booking      @relation(fields: [bookingId], references: [id])
  showtimeId    String
  showtime      Showtime     @relation(fields: [showtimeId], references: [id])
  seatId        String
  seat          Seat         @relation(fields: [seatId], references: [id])
  priceConfigId String?
  priceConfig   PriceConfig? @relation(fields: [priceConfigId], references: [id], onDelete: SetNull)
  price         Float
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([showtimeId])
  @@index([bookingId])
  @@index([seatId])
  @@index([priceConfigId])
}

model FoodCombo {
  id           String        @id @default(uuid())
  name         String
  description  String?
  price        Float
  imageUrl     String?
  status       String        @default("ACTIVE")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bookingFoods BookingFood[]
}

model BookingFood {
  id        String    @id @default(uuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id])
  foodId    String
  food      FoodCombo @relation(fields: [foodId], references: [id])
  quantity  Int
  price     Float
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Voucher {
  id            String     @id @default(uuid())
  code          String     @unique
  discountType  String // PERCENTAGE, FIXED_AMOUNT
  discountValue Float
  minOrderValue Float      @default(0)
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int
  usedCount     Int        @default(0)
  status        String     @default("ACTIVE")
  promotionId   String?
  promotion     Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  bookings      Booking[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([promotionId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([movieId])
  @@index([userId])
}

model SeatHold {
  id         String   @id @default(uuid())
  showtimeId String
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seatId     String
  seat       Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([showtimeId, expiresAt])
  @@index([seatId])
  @@index([userId])
}

model PriceConfig {
  id        String   @id @default(uuid())
  seatType  SeatType
  format    String // 2D, 3D, IMAX
  isWeekend Boolean  @default(false)
  price     Float
  tickets   Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Genre {
  id          String       @id @default(uuid())
  name        String       @unique
  movieGenres MovieGenre[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Actor {
  id          String       @id @default(uuid())
  name        String       @unique
  avatarUrl   String?
  movieActors MovieActor[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model MovieGenre {
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genreId   String
  genre     Genre    @relation(fields: [genreId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([movieId, genreId])
  @@index([movieId])
  @@index([genreId])
}

model MovieActor {
  movieId       String
  movie         Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  actorId       String
  actor         Actor    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  characterName String?
  createdAt     DateTime @default(now())

  @@id([movieId, actorId])
  @@index([movieId])
  @@index([actorId])
}

model Promotion {
  id         String    @id @default(uuid())
  title      String
  desc       String
  category   String // MEMBER, PARTNER, STUDENT, etc.
  badge      String?
  code       String?
  validUntil String
  terms      String
  coverUrl   String?
  iconType   String    @default("ticket")
  status     String    @default("ACTIVE")
  vouchers   Voucher[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Blog {
  id          String   @id @default(uuid())
  title       String
  summary     String
  content     String
  category    String // Review Phim, Tin Điện Ảnh, Phim Sắp Chiếu
  author      String   @default("Aeon Cine Editor")
  authorId    String?
  authorUser  User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  movieId     String?
  movie       Movie?   @relation(fields: [movieId], references: [id], onDelete: SetNull)
  publishDate String
  readingTime String   @default("5 phút đọc")
  imageUrl    String?
  views       Int      @default(0)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@index([movieId])
}

model GroupBooking {
  id             String   @id @default(uuid())
  contactName    String
  phone          String
  email          String
  companyName    String?
  cinemaId       String?
  cinema         Cinema?  @relation(fields: [cinemaId], references: [id], onDelete: SetNull)
  cinemaName     String?
  serviceType    String // GROUP_TICKET, HALL_RENTAL, VOUCHER, EVENT
  expectedGuests Int
  expectedDate   String?
  notes          String?
  status         String   @default("PENDING") // PENDING, CONTACTED, CONFIRMED, CANCELLED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([cinemaId])
  @@index([status])
  @@index([createdAt])
}
