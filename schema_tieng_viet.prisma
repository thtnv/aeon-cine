// =============================================================================
// PRISMA SCHEMA TIẾNG VIỆT - HỆ THỐNG ĐẶT VÉ PHIM AEON CINE
// Bản dịch cơ sở dữ liệu phục vụ kiểm tra Đồ án Tốt nghiệp
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. BẢNG NGƯỜI DÙNG / TÀI KHOẢN
model NguoiDung {
  maNguoiDung    String      @id @default(uuid()) @map("id")
  email          String      @unique @map("email")
  matKhau        String      @map("password")
  hoTen          String      @map("name")
  vaiTro         VaiTro      @default(KHACH_HANG) @map("role")
  soDienThoai    String?     @map("phone")
  anhDaiDien     String?     @map("avatar")
  ngaySinh       String?     @map("birthDate")
  gioiTinh       String?     @map("gender")
  diemTichLuy    Int         @default(0) @map("rewardPoints")
  hangThanhVien  String      @default("STAR") @map("membershipLevel") // STAR, GSTAR, XSTAR
  ngayTao        DateTime    @default(now()) @map("createdAt")
  ngayCapNhat    DateTime    @updatedAt @map("updatedAt")
  donDatVes      DonDatVe[]
  danhGiaBinhLuans DanhGiaBinhLuan[]

  @@map("User")
}

enum VaiTro {
  KHACH_HANG @map("USER")
  QUAN_TRI_VIEN @map("ADMIN")
  NHAN_VIEN @map("STAFF")

  @@map("Role")
}

// 2. BẢNG PHIM ĐIỆN ẢNH
model Phim {
  maPhim           String      @id @default(uuid()) @map("id")
  tenPhim          String      @map("title")
  moTa             String      @map("description")
  theLoai          String      @map("genre")
  thoiLuong        Int         @map("duration") // Thời lượng tính bằng phút
  duongDanTrailer  String?     @map("trailerUrl")
  duongDanPoster   String?     @map("posterUrl")
  trangThai        String      @map("status") // NOW_SHOWING, COMING_SOON
  ngayKhoiChieu    String?     @map("releaseDate")
  phanLoaiDoTuoi   String?     @map("ageRating") // P, K, T13, T16, T18
  danhGiaTrungBinh Float?      @map("rating")
  tongSoLuotDanhGia Int?       @map("votes")
  quocGia          String?     @map("country")
  nhaSanXuat       String?     @map("producer")
  daoDien          String?     @map("director")
  dienVien         String?     @map("actors")
  ngayTao          DateTime    @default(now()) @map("createdAt")
  ngayCapNhat      DateTime    @updatedAt @map("updatedAt")
  suatChieus       SuatChieu[]
  danhGiaBinhLuans DanhGiaBinhLuan[]

  @@map("Movie")
}

// 3. BẢNG CỤM RẠP
model CumRap {
  maCumRap         String       @id @default(uuid()) @map("id")
  tenCumRap        String       @map("name")
  khuVuc           String       @map("location")
  diaChi           String?      @map("address")
  thanhPho         String       @default("TP.HCM") @map("city")
  soDienThoai      String?      @map("phone")
  duongDanBanDo    String?      @map("mapUrl")
  duongDanChiDuong String?      @map("directionsUrl")
  tienIch          String[]     @default([]) @map("amenities")
  phongChieus      PhongChieu[]
  ngayTao          DateTime     @default(now()) @map("createdAt")
  ngayCapNhat      DateTime     @updatedAt @map("updatedAt")

  @@map("Cinema")
}

// 4. BẢNG PHÒNG CHIẾU
model PhongChieu {
  maPhongChieu String      @id @default(uuid()) @map("id")
  tenPhongChieu String     @map("name")
  maCumRap     String      @map("cinemaId")
  cumRap       CumRap      @relation(fields: [maCumRap], references: [maCumRap])
  gheNgois     GheNgoi[]
  suatChieus   SuatChieu[]
  ngayTao      DateTime    @default(now()) @map("createdAt")
  ngayCapNhat  DateTime    @updatedAt @map("updatedAt")

  @@map("Room")
}

// 5. BẢNG GHẾ NGỒI
model GheNgoi {
  maGhe        String      @id @default(uuid()) @map("id")
  tenGhe       String      @map("name") // A1, B2...
  loaiGhe      LoaiGhe     @default(THUONG) @map("type")
  maPhongChieu String      @map("roomId")
  phongChieu   PhongChieu  @relation(fields: [maPhongChieu], references: [maPhongChieu])
  veXemPhims   VeXemPhim[]

  @@map("Seat")
}

enum LoaiGhe {
  THUONG @map("STANDARD")
  VIP @map("VIP")
  SWEETBOX @map("SWEETBOX")

  @@map("SeatType")
}

// 6. BẢNG SUẤT CHIẾU
model SuatChieu {
  maSuatChieu    String       @id @default(uuid()) @map("id")
  maPhim         String       @map("movieId")
  phim           Phim         @relation(fields: [maPhim], references: [maPhim])
  maPhongChieu   String       @map("roomId")
  phongChieu     PhongChieu   @relation(fields: [maPhongChieu], references: [maPhongChieu])
  dinhDang       String       @default("2D") @map("format") // 2D, 3D, IMAX
  ngonNgu        String       @default("SUB") @map("language") // SUB, DUB
  thoiGianBatDau DateTime     @map("startTime")
  thoiGianKetThuc DateTime    @map("endTime")
  veXemPhims     VeXemPhim[]
  khoaGiuGhes    KhoaGiuGheTamThoi[]
  ngayTao        DateTime     @default(now()) @map("createdAt")
  ngayCapNhat    DateTime     @updatedAt @map("updatedAt")

  @@map("Showtime")
}

// 7. BẢNG ĐƠN ĐẶT VÉ
model DonDatVe {
  maDonHang           String        @id @default(uuid()) @map("id")
  maNguoiDung         String        @map("userId")
  nguoiDung           NguoiDung     @relation(fields: [maNguoiDung], references: [maNguoiDung])
  trangThaiDonHang    String        @map("status") // PENDING, COMPLETED, CANCELLED
  phuongThucThanhToan String?       @map("paymentMethod") // VNPAY, MOMO, CASH
  trangThaiThanhToan  String        @default("UNPAID") @map("paymentStatus")
  maVoucher           String?       @map("voucherCode")
  soTienGiamGia       Float         @default(0) @map("discountAmount")
  maVeDienTu          String?       @unique @map("ticketCode")
  duongDanMaQR        String?       @map("qrCodeUrl")
  tongTien            Float         @map("total")
  veXemPhims          VeXemPhim[]
  chiTietCombos       ChiTietComboDonHang[]
  ngayTao             DateTime      @default(now()) @map("createdAt")
  ngayCapNhat         DateTime      @updatedAt @map("updatedAt")

  @@map("Booking")
}

// 8. BẢNG CHI TIẾT VÉ XEM PHIM
model VeXemPhim {
  maVe         String     @id @default(uuid()) @map("id")
  maDonHang    String     @map("bookingId")
  donDatVe     DonDatVe   @relation(fields: [maDonHang], references: [maDonHang])
  maSuatChieu  String     @map("showtimeId")
  suatChieu    SuatChieu  @relation(fields: [maSuatChieu], references: [maSuatChieu])
  maGhe        String     @map("seatId")
  gheNgoi      GheNgoi    @relation(fields: [maGhe], references: [maGhe])
  giaVe        Float      @map("price")
  ngayTao      DateTime   @default(now()) @map("createdAt")
  ngayCapNhat  DateTime   @updatedAt @map("updatedAt")

  @@map("Ticket")
}

// 9. BẢNG COMBO BẮP NƯỚC
model ComboBapNuoc {
  maCombo         String                @id @default(uuid()) @map("id")
  tenCombo        String                @map("name")
  moTa            String?               @map("description")
  giaBan          Float                 @map("price")
  duongDanHinhAnh String?               @map("imageUrl")
  trangThai       String                @default("ACTIVE") @map("status")
  ngayTao         DateTime              @default(now()) @map("createdAt")
  ngayCapNhat     DateTime              @updatedAt @map("updatedAt")
  chiTietCombos   ChiTietComboDonHang[]

  @@map("FoodCombo")
}

// 10. BẢNG CHI TIẾT BẮP NƯỚC ĐƠN HÀNG
model ChiTietComboDonHang {
  maChiTietCombo String       @id @default(uuid()) @map("id")
  maDonHang      String       @map("bookingId")
  donDatVe       DonDatVe     @relation(fields: [maDonHang], references: [maDonHang])
  maCombo        String       @map("foodId")
  comboBapNuoc   ComboBapNuoc @relation(fields: [maCombo], references: [maCombo])
  soLuong        Int          @map("quantity")
  donGia         Float        @map("price")
  ngayTao        DateTime     @default(now()) @map("createdAt")
  ngayCapNhat    DateTime     @updatedAt @map("updatedAt")

  @@map("BookingFood")
}

// 11. BẢNG MÃ GIẢM GIÁ (VOUCHER)
model MaGiamGia {
  maVoucher         String   @id @default(uuid()) @map("id")
  maCode            String   @unique @map("code")
  loaiGiamGia       String   @map("discountType") // PERCENTAGE, FIXED_AMOUNT
  giaTriGiam        Float    @map("discountValue")
  giaTriDonToiThieu Float    @default(0) @map("minOrderValue")
  ngayBatDau        DateTime @map("startDate")
  ngayKetThuc       DateTime @map("endDate")
  gioiHanSuDung     Int      @map("usageLimit")
  soLuotDaDung      Int      @default(0) @map("usedCount")
  trangThai         String   @default("ACTIVE") @map("status")
  ngayTao           DateTime @default(now()) @map("createdAt")
  ngayCapNhat       DateTime @updatedAt @map("updatedAt")

  @@map("Voucher")
}

// 12. BẢNG ĐÁNH GIÁ & BÌNH LUẬN
model DanhGiaBinhLuan {
  maDanhGia      String    @id @default(uuid()) @map("id")
  maNguoiDung    String    @map("userId")
  nguoiDung      NguoiDung @relation(fields: [maNguoiDung], references: [maNguoiDung])
  maPhim         String    @map("movieId")
  phim           Phim      @relation(fields: [maPhim], references: [maPhim])
  soSaoDanhGia   Int       @map("rating")
  noiDungBinhLuan String   @map("comment")
  ngayTao        DateTime  @default(now()) @map("createdAt")
  ngayCapNhat    DateTime  @updatedAt @map("updatedAt")

  @@map("Review")
}

// 13. BẢNG KHÓA GIỮ GHẾ TẠM THỜI
model KhoaGiuGheTamThoi {
  maGiuGhe       String    @id @default(uuid()) @map("id")
  maSuatChieu    String    @map("showtimeId")
  suatChieu      SuatChieu @relation(fields: [maSuatChieu], references: [maSuatChieu])
  maGhe          String    @map("seatId")
  maNguoiDung    String    @map("userId")
  thoiGianHetHan DateTime  @map("expiresAt")
  ngayTao        DateTime  @default(now()) @map("createdAt")

  @@map("SeatHold")
}

// 14. BẢNG CẤU HÌNH BẢNG GIÁ VÉ
model BangGiaVe {
  maBangGia  String   @id @default(uuid()) @map("id")
  loaiGhe    LoaiGhe  @map("seatType")
  dinhDang   String   @map("format") // 2D, 3D, IMAX
  laCuoiTuan Boolean  @default(false) @map("isWeekend")
  giaVe      Float    @map("price")
  ngayTao    DateTime @default(now()) @map("createdAt")
  ngayCapNhat DateTime @updatedAt @map("updatedAt")

  @@map("PriceConfig")
}

// 15. BẢNG THỂ LOẠI PHIM
model TheLoaiPhim {
  maTheLoai  String   @id @default(uuid()) @map("id")
  tenTheLoai String   @unique @map("name")
  ngayTao    DateTime @default(now()) @map("createdAt")
  ngayCapNhat DateTime @updatedAt @map("updatedAt")

  @@map("Genre")
}

// 16. BẢNG DIỄN VIÊN
model DienVien {
  maDienVien  String   @id @default(uuid()) @map("id")
  tenDienVien String   @unique @map("name")
  duongDanAnh String?  @map("avatarUrl")
  ngayTao     DateTime @default(now()) @map("createdAt")
  ngayCapNhat DateTime @updatedAt @map("updatedAt")

  @@map("Actor")
}

// 17. BẢNG CHƯƠNG TRÌNH KHUYẾN MÃI
model ChuongTrinhKhuyenMai {
  maKhuyenMai   String   @id @default(uuid()) @map("id")
  tieuDe        String   @map("title")
  moTa          String   @map("desc")
  danhMuc       String   @map("category")
  nhanNoiBat    String?  @map("badge")
  maCode        String?  @map("code")
  hanSuDung     String   @map("validUntil")
  dieuKhoan     String   @map("terms")
  duongDanAnhBia String? @map("coverUrl")
  loaiIcon      String   @default("ticket") @map("iconType")
  trangThai     String   @default("ACTIVE") @map("status")
  ngayTao       DateTime @default(now()) @map("createdAt")
  ngayCapNhat   DateTime @updatedAt @map("updatedAt")

  @@map("Promotion")
}

// 18. BẢNG BÀI VIẾT GÓC ĐIỆN ẢNH
model BaiVietTinTuc {
  maBaiViet   String   @id @default(uuid()) @map("id")
  tieuDe      String   @map("title")
  tomTat      String   @map("summary")
  noiDung     String   @map("content")
  danhMuc     String   @map("category")
  tacGia      String   @default("Aeon Cine Editor") @map("author")
  ngayDang    String   @map("publishDate")
  thoiGianDoc String   @default("5 phút đọc") @map("readingTime")
  duongDanAnh String?  @map("imageUrl")
  luotXem     Int      @default(0) @map("views")
  trangThai   String   @default("ACTIVE") @map("status")
  ngayTao     DateTime @default(now()) @map("createdAt")
  ngayCapNhat DateTime @updatedAt @map("updatedAt")

  @@map("Blog")
}
